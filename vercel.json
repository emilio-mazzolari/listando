{
  "crons": [
    {
      "path": "/api/notify-weekly",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/backup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/notify-birthday",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/notify-viaggio-saldi",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/annuncio/:id",
      "destination": "/api/vendita?id=:id"
    }
  ]
}
